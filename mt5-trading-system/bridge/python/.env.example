# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is already .gitignore'd).

# Shared secret TradingView alerts must present, via one of:
#   Authorization: Bearer <token>   header
#   {"token": "..."} or {"secret": "..."}   JSON body field
#   ?token=...                              query parameter
# REQUIRED -- the app fails to start without it. Use a long random value,
# e.g. `openssl rand -hex 32`.
VBE_SECRET=replace-with-a-long-random-secret

# Path to the JSON-Lines signal file the MT5 EA polls (InpSignalFile in
# the EA's inputs, default "vbe_signals.jsonl"). Point this at:
#   <MT5 terminal data folder>/MQL5/Files/vbe_signals.jsonl
# Run the bridge on the same host as the terminal so this can be a plain
# local path -- see README.md for why that matters for latency.
VBE_SIGNAL_FILE=./vbe_signals.jsonl

# Sidecar file that persists the last assigned signal id across bridge
# restarts, guaranteeing ids stay strictly monotonic. Defaults to
# VBE_SIGNAL_FILE with a .seq extension when left unset.
# VBE_SEQ_FILE=./vbe_signals.seq

VBE_HOST=0.0.0.0
VBE_PORT=8080

# If false, reject two consecutive identical actions (e.g. buy right
# after buy) with HTTP 422 instead of writing a redundant signal.
VBE_ALLOW_DUPLICATE_ACTIONS=true
