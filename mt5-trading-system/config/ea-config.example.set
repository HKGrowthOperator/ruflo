; Vantage Basket EA - Beispiel-Preset (konservativ, Basket-TP in Geld)
; In MetaTrader: EA-Eigenschaften -> Reiter "Inputs" -> "Load" -> diese Datei.
; Format: <InputName>=<Wert>
InpMagic=990101
InpSymbol=
InpTradeComment=VantageBasket
InpStartLot=0.10
InpLotIncrement=0.10
InpMaxLotPerTrade=5.00
InpSignalSource=1
InpIndicatorName=VantageSignal
InpSignalBufferBuy=0
InpSignalBufferSell=1
InpSignalOnBarCloseOnly=true
InpSignalFile=vbe_signals.jsonl
InpSlippagePoints=20
InpMaxRetries=3
InpRetryDelayMs=300
InpEnableBasketTP=true
InpBasketTPBasis=0
InpBasketTPValue=100.0
InpEnableBasketSL=false
InpBasketSLBasis=0
InpBasketSLValue=300.0
InpResetAfterBasketClose=true
InpEnableEquityStop=false
InpEquityMinAbsolute=0.0
InpEquityMaxLossPct=0.0
InpDisableEAOnEquityStop=true
InpEnableMaxTrades=false
InpMaxOpenTrades=20
InpEnableMaxMargin=false
InpMaxMarginUsagePct=80.0
InpEnableMaxDrawdown=false
InpMaxDrawdownPct=30.0
InpEnableSpreadFilter=true
InpMaxSpreadPoints=40.0
InpEnableATRFilter=false
InpATRPeriod=14
InpATRMinPoints=0.0
InpATRMaxPoints=0.0
InpEnableTrendFilter=false
InpTrendMAPeriod=200
InpTrendMAMethod=1
InpTrendMATimeframe=0
InpEnableTimeFilter=false
InpTradeStartHour=0
InpTradeStartMinute=0
InpTradeEndHour=23
InpTradeEndMinute=59
InpEnableDayFilter=false
InpTradeMonday=true
InpTradeTuesday=true
InpTradeWednesday=true
InpTradeThursday=true
InpTradeFriday=true
InpTradeSaturday=false
InpTradeSunday=false
InpEnableNewsFilter=false
InpNewsPauseBefore=15
InpNewsPauseAfter=15
InpNewsFile=vbe_news.txt
InpLogToFile=true
InpLogLevel=1
InpLogPrefix=VBE
InpShowDashboard=true
InpShowResetButton=true
InpEnablePush=false
InpEnableEmail=false
InpEnableTelegram=false
InpTelegramToken=
InpTelegramChatId=
InpTimerIntervalMs=250
