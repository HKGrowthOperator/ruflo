# Pfad zur SQLite-Datenbank (Standard: ./data/pruefungscoach.db)
DATABASE_PATH=./data/pruefungscoach.db

# Anthropic-API-Key für die KI-Bewertung freier Antworten.
# Ohne Key läuft die App vollständig mit dem deterministischen Kriterien-Matcher.
ANTHROPIC_API_KEY=

# Modell für Bewertungs-/Tutoragent
ANTHROPIC_MODEL=claude-sonnet-5

# Session-Secret für Cookie-Signierung (in Produktion setzen!)
SESSION_SECRET=change-me-in-production
