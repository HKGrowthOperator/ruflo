# --- Basis -----------------------------------------------------------------
# Pfad zur SQLite-Datenbank (Standard: ./data/pruefungscoach.db)
DATABASE_PATH=./data/pruefungscoach.db

# Öffentliche Basis-URL der App (für Zahlungs-Redirects und Reset-Links)
APP_BASE_URL=http://localhost:3100

# Session-Secret für Cookie-Sicherheit (in Produktion langen Zufallswert setzen!)
SESSION_SECRET=change-me-in-production

# --- Admin-Konto (Produktion) ----------------------------------------------
# Wenn gesetzt, wird dieses Admin-Konto angelegt und die Demo-Accounts entfallen.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- KI-Bewertung freier Antworten (optional) ------------------------------
# Ohne Key läuft der deterministische Kriterien-Matcher.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Bezahlung (optional) ---------------------------------------------------
# Ohne diese Werte läuft die App im Free-Live-Modus (alles kostenlos).
# Mit STRIPE_SECRET_KEY + STRIPE_PRICE_ID wird der Kauf aktiv.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Anzeigepreis in Euro (nur Darstellung; verbindlich ist der Stripe-Preis)
PRICE_DISPLAY_EUR=39

# --- E-Mail (optional, für Passwort-Reset) ---------------------------------
# Ohne Key werden Reset-Links nur in die Server-Logs geschrieben (Testphase).
RESEND_API_KEY=
EMAIL_FROM=Prüfungscoach <onboarding@resend.dev>
