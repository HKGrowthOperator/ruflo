# ── Betriebsmodus ─────────────────────────────────────────────
# Ohne weitere Konfiguration läuft alles im Dev-Modus:
#  - Datenhaltung: JSON-Dateien unter .data/ (kein Postgres nötig)
#  - KI: Mock-Provider (extraktive Entwürfe, keine API-Kosten)

# ── Admin-Zugang (Basic Auth für /admin) ──────────────────────
# Wenn leer, ist /admin ungeschützt (nur für lokale Entwicklung!)
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── KI-Provider (Anthropic) ───────────────────────────────────
# Sobald gesetzt, erstellt Claude echte tamilische Artikelentwürfe.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Supabase (Produktions-Datenbank) ──────────────────────────
# Sobald beide gesetzt sind, wird Supabase statt des Dev-Stores genutzt.
# Schema: supabase/migrations/0001_init.sql, Seed: supabase/seed.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Radar ─────────────────────────────────────────────────────
# Geheimnis für den Cron-Endpoint /api/cron/radar (Vercel Cron sendet
# es automatisch als "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
# Mindestanzahl unabhängiger Quellen, bevor automatisch ein Entwurf
# erstellt wird (Standard 2; sensible Kategorien verlangen 3).
TNR_MIN_SOURCES_FOR_DRAFT=2
# Zeitfenster in Stunden, in dem neue Meldungen bestehenden Stories
# zugeordnet werden (Ereignis-Clustering).
TNR_CLUSTER_WINDOW_HOURS=72
# Ablageort des Dev-Stores (Standard: <projektwurzel>/.data)
TNR_DATA_DIR=

# ── WordPress-Publishing (optional) ───────────────────────────
# Freigegebene Artikel können zusätzlich in ein WordPress gepusht
# werden (REST API + Application Password).
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
# draft | publish – mit welchem Status der Beitrag in WordPress landet
WORDPRESS_PUBLISH_STATUS=draft
